# =============================================================
# 케어닥 포괄평가기록 — 환경변수
#
# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요.
#   cp .env.local.example .env.local
#
# .env.local 은 .gitignore 에 있어 저장소에 올라가지 않습니다.
# Vercel 에 배포할 때는 같은 값을 Vercel 프로젝트 설정 →
# Environment Variables 에 넣으세요.
# =============================================================

# -------------------------------------------------------------
# Supabase — 대시보드 → Project Settings → API 에서 복사
# ★ 프로젝트는 반드시 Seoul (ap-northeast-2) 리전으로 만드세요.
#    환자 정보를 국외로 내보내지 않기 위한 조치입니다.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ service_role 키는 모든 보안을 통과하는 마스터 키입니다.
#    서버에서만 사용하며 절대 브라우저로 나가지 않습니다.
#    (NEXT_PUBLIC_ 접두사를 붙이면 안 됩니다)
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# 최초 관리자 계정 — `npm run seed:admin` 이 이 값으로 계정을 만듭니다.
#
# ⚠ admin123 은 매우 취약한 비밀번호입니다.
#    개발·테스트까지만 쓰고, 실제 환자 정보를 넣기 전에 반드시 변경하세요.
#    앱이 최초 로그인 시 비밀번호 변경을 강제합니다.
#
# 비밀번호는 Supabase 가 bcrypt 로 해시해 저장하므로
# 데이터베이스에 평문으로 남지 않습니다.
# -------------------------------------------------------------
ADMIN_EMAIL=admin@caredoc.com
ADMIN_NAME=관리자
ADMIN_INITIAL_PASSWORD=admin123
